# ─── Identity ────────────────────────────────────────────────────────────────
AGENT_ID=assistant
AGENT_NAME=Assistant

# ─── Model ───────────────────────────────────────────────────────────────────
# provider ∈ anthropic | openai | google | openrouter | litellm
# MODEL_ID accepts a concrete id OR a tier alias resolved via MODEL_TIERS
# (src/agent_app/models.py): @fast | @medium | @high
# IDs age fast — list the provider's live models API before pinning.
MODEL_PROVIDER=anthropic
MODEL_ID=@medium

# Fallback model (optional): retries the run when the primary errors,
# rate-limits or overflows context. Cross-provider = survives provider outages.
# FALLBACK_PROVIDER=openai
# FALLBACK_MODEL_ID=gpt-5.6-terra
# Provider key (or use the provider-specific var below):
# MODEL_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=          # provider google/gemini
# OPENROUTER_API_KEY=
# For litellm/openrouter proxies:
# MODEL_BASE_URL=https://llm.khal.ai

# ─── Persistence ─────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use a local SQLite file (tmp/agent.db).
# In Docker Compose this is set to the bundled Postgres.
DATABASE_URL=
# SQLITE_FILE=tmp/agent.db

# ─── Knowledge (optional; needs an embedder key) ─────────────────────────────
KNOWLEDGE_ENABLED=0
# EMBEDDER_PROVIDER=openai
# EMBEDDER_ID=text-embedding-3-small
# OPENAI_API_KEY=            # embedder key (can differ from the chat model)

# ─── Serving ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8888
API_WORKERS=2
# Bearer token gating every non-public route. Leave empty to disable auth (dev only).
API_KEY=

# ─── Prompt caching (Anthropic) ──────────────────────────────────────────────
# Cache the static system prompt (big win on large prompts). Keep the system
# prompt byte-stable — volatile data (date, user ctx) is injected as message-0.
PROMPT_CACHE=1
CACHE_EXTENDED_TTL=1          # 1h cache TTL instead of the default 5min
# Freeze "today" at build time so the cached prefix stays stable within a process.
# Set this to your deploy date in CI/CD; defaults to today() at boot.
# BUILD_DATE=2026-07-14

# ─── Observability (connector register) ──────────────────────────────────────
# The ONLY observability setting: the per-client connector register URL. Unset →
# tracing off. Trace/event endpoints, credentials and TTL are resolved from the
# register at runtime — NEVER put a vendor (LangWatch/...) address or key here;
# the platform can move hosts, rotate keys or swap vendors without touching this.
# CONNECTOR_REGISTER_URL=https://connectorregister.<client>.example.com
# Trace metadata (rich by default — fixes service.name=unknown_service):
OTEL_SERVICE_NAME=nsmtx-agent-template
# This deployment/replica's name → `agent.instance` on every trace (defaults to
# the container hostname; set explicitly when you run several replicas):
# AGENT_INSTANCE=martino-prod-1
ENVIRONMENT=dev                # dev | staging | prod  → deployment.environment
# The agent VERSION comes from src/agent_app/_version.py (single source) — not env.
# GIT_SHA is optional build provenance; set it in CI/CD (defaults to "unknown").
# GIT_SHA=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
# Log format. Defaults to JSON everywhere except ENVIRONMENT=dev (pretty console).
# Set LOG_JSON=1 in dev to preview production output, or 0 in prod for readability.
# LOG_JSON=1

# ─── Experiments (A/B testing) ───────────────────────────────────────────────
# Where runtime traffic-weight overrides are persisted (baseline weights live in
# git — experiments/registry.py). Default is under tmp/ (gitignored). Shared
# across uvicorn workers on one host; for multi-pod k8s back it with your DB/Redis
# or a flag provider — see experiments/store.py and docs/ab-testing.md.
# EXPERIMENTS_STORE_PATH=tmp/experiment_allocations.json

# ─── Omni (omnichannel webhook adapter) ──────────────────────────────────────
# The template exposes POST /omni/webhook for Automagik Omni's webhook provider
# (WhatsApp/Slack/Discord/… → agent). See docs/omni.md.
# Which agent answers channel messages (baseline mode). Defaults to AGENT_ID.
# OMNI_AGENT_ID=assistant
# Route channel messages through an A/B experiment instead (sticky per sender —
# each WhatsApp number gets a consistent arm). Empty = baseline (single agent).
# OMNI_EXPERIMENT=assistant-tone
# Seeds the Omni API bearer key for the local validation stack (make omni-up).
# OMNI_API_KEY=omni_sk_dev_local
# Host port for the local Omni stack. Change it if you ALSO run Omni natively
# (a native Omni on :8882 shadows the container). See docs/omni.md.
# OMNI_HOST_PORT=8882

# ─── Guardrails ──────────────────────────────────────────────────────────────
# Max inbound text (chars) the input guardrail accepts (hooks/pre_hooks.py).
# A cost/DoS cap — NOT a content rule. Raise it for doc/media-heavy agents (a PDF
# extraction or image description arrives AS text and is large); lower it for
# untrusted chat-only agents. Default 50000 (~12k tokens).
# MAX_INPUT_CHARS=50000

# ─── Misc ────────────────────────────────────────────────────────────────────
DEBUG=0
TZ=America/Sao_Paulo
