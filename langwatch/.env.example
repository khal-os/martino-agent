# LangWatch self-host env. Copy to `langwatch/.env`.
# These are the common knobs; consult LangWatch's self-hosting docs for the full
# list (https://langwatch.ai/docs). SKIP_ENV_VALIDATION=true (set in compose)
# lets the stack boot with minimal config for local/dev.

# Secret used to sign sessions (generate: openssl rand -base64 32)
NEXTAUTH_SECRET=change-me-openssl-rand-base64-32

# Public base URL of the LangWatch app (the UI you open in the browser)
BASE_HOST=http://localhost:5560
NEXTAUTH_URL=http://localhost:5560

# API key used by internal cron/metrics jobs (any random string)
CRON_API_KEY=change-me-random

# Optional: SMTP / SSO / provider keys — see LangWatch docs if you need them.
