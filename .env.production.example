# Production secrets — copy to .env.production and fill in, then `make aws-secrets`.
# ONLY the sensitive values live here; non-secret config is in copilot/agent/manifest.yml
# (variables:) for AWS, or docker-compose.prod.yml for a VM. .env.production is
# gitignored — never commit real keys.

# REQUIRED in prod. Without it every protected route denies (fail-closed). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Model provider key (match MODEL_PROVIDER in the manifest — anthropic by default).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# Cross-provider fallback key (optional — enable FALLBACK_* in the manifest too).
# FALLBACK_API_KEY=

# Observability (optional — set LANGWATCH_ENABLED=1 in the manifest to activate).
# LANGWATCH_API_KEY=

# NOTE: DATABASE_URL is NOT set here. On AWS it is assembled from the Aurora secret
# by scripts/aws/entrypoint.sh. On a VM (docker-compose.prod.yml) it points at the
# bundled Postgres.
